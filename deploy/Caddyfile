# Reverse proxy for the Provenance Gateway.
#
# The gateway containers bind to loopback only (GATEWAY_BIND=127.0.0.1), so this
# proxy is the single entry point and terminates TLS. Publishing the gateway
# ports directly would bypass it: Docker publishes through its own iptables
# chains, which are not filtered by ufw.
#
# Hostnames come from the environment so this file is not tied to one
# deployment. Set them in /etc/default/caddy (or the systemd unit's environment):
#
#   GATEWAY_HOST=provenance-gateway.example.io
#   GATEWAY_DEV_HOST=provenance-gateway.dev.example.io
#   ACME_EMAIL=ops@example.io
#
# Apply with:
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# `caddy validate` treats deprecation warnings as failure, so it is worth running
# before every reload rather than trusting a config that merely looks right.

{
	email {$ACME_EMAIL}
}

{$GATEWAY_HOST} {
	# Caddy sets X-Forwarded-For by default. The gateway reads it to identify
	# the caller, and without it every caller collapses into one bucket —
	# per-IP rate limiting, the x402 free-tier allowance and the daily spend
	# budget would all be shared globally rather than per client.
	#
	# The gateway counts back from the RIGHT of that header by
	# TRUSTED_PROXY_HOPS (default 1), so it is correct whether Caddy replaces
	# the header or appends to it.
	#
	# As configured here (no trusted_proxies), Caddy REPLACES the header with
	# one entry: the address of whatever connected to it. That has two
	# consequences:
	#
	# - TRUSTED_PROXY_HOPS above 1 makes every header shorter than the hop
	#   count, so every request falls back to the direct TCP peer (Caddy, or
	#   the Docker bridge address in front of the container, believed but not
	#   measured on the hosts) and all callers share one bucket: over-limiting,
	#   not a bypass. A caller
	#   can choose their own identity with a value that is too high only when
	#   the outermost proxy appends to a header the caller sent, for example a
	#   Caddy with trusted_proxies covering a front proxy that appends.
	# - IF YOU ADD A PROXY OR CDN IN FRONT OF THIS ONE, raising
	#   TRUSTED_PROXY_HOPS is not enough on its own: Caddy would still discard
	#   the front proxy's header and write only the front proxy's address, so
	#   every request would share one budget. Also add
	#   `trusted_proxies <front proxy range>` to the reverse_proxy block below
	#   (or `trusted_proxies static <range>` under the global `servers`
	#   option), so Caddy appends instead, and only for that proxy's range.
	#   Then set TRUSTED_PROXY_HOPS to the number of proxies, here 2.
	# Each entry the gateway relies on must be a bare IP address (no port), or
	# it uses the direct peer instead; X-Real-IP is not read at all (#697).
	# Prometheus metrics are NOT public (#188). The endpoint exposed 146 series to
	# anyone who asked: wallet addresses, BZZ and xDAI balances, gateway version,
	# which features are enabled, and request volumes — a funding position, in
	# other words, readable by whoever is deciding whether draining it is worth
	# attempting.
	#
	# Nothing legitimate is lost. Alloy scrapes the container directly over the
	# compose network (provenance_gateway:8000) and never traverses this proxy, so
	# Grafana is unaffected. An operator on the host still reaches the published
	# loopback port. /health carries version and uptime_seconds for anything
	# outside that needs to detect a redeploy.
	#
	# 404 rather than 403: a refusal confirms the endpoint is there.
	handle /metrics {
		respond 404
	}

	# Cap request bodies at the edge (#354): uploads are limited to 10 MB by
	# the gateway, which only notices after reading the body. Keep this a bit
	# above MAX_UPLOAD_SIZE_MB (plus multipart overhead); raising that setting
	# past ~11 MB needs this raised too, or Caddy answers a bare 413 first.
	request_body {
		max_size 12MB
	}
	reverse_proxy 127.0.0.1:8899 {
		# Swarm uploads can be slow; do not cut them off mid-transfer.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	encode gzip

	# stdout, captured by journald (journalctl -u caddy). Writing to a file under
	# /var/log/caddy fails with permission denied under the packaged unit's
	# sandboxing, and with no log directive at all Caddy records no requests —
	# which left us unable to answer "was anyone calling this gateway?".
	log {
		output stdout
		format json
	}
}

{$GATEWAY_DEV_HOST} {
	# The X-Forwarded-For note on the site above applies here too: the gateway
	# identifies callers from that header, and TRUSTED_PROXY_HOPS must match the
	# real number of proxies in front of it.
	# Prometheus metrics are NOT public (#188). The endpoint exposed 146 series to
	# anyone who asked: wallet addresses, BZZ and xDAI balances, gateway version,
	# which features are enabled, and request volumes — a funding position, in
	# other words, readable by whoever is deciding whether draining it is worth
	# attempting.
	#
	# Nothing legitimate is lost. Alloy scrapes the container directly over the
	# compose network (provenance_gateway:8000) and never traverses this proxy, so
	# Grafana is unaffected. An operator on the host still reaches the published
	# loopback port. /health carries version and uptime_seconds for anything
	# outside that needs to detect a redeploy.
	#
	# 404 rather than 403: a refusal confirms the endpoint is there.
	handle /metrics {
		respond 404
	}

	request_body {
		max_size 12MB
	}
	reverse_proxy 127.0.0.1:8900 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	encode gzip

	log {
		output stdout
		format json
	}
}
