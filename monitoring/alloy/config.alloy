// Grafana Alloy configuration for Provenance Gateway monitoring
//
// Scrapes /metrics from the gateway containers and the bundled Bee nodes and
// pushes to Grafana Cloud Prometheus, and tails the gateway containers' logs
// and pushes them to Grafana Cloud Loki.
//
// The two pipelines are independent components. If the Loki credentials are
// absent the log pipeline reports unhealthy and drops logs; metrics are
// unaffected. That is the intended failure mode — a host that has not been
// given Loki credentials still collects metrics.

// ── Scrape development gateway (dev branch) ─────────────────────────────────

prometheus.scrape "development" {
  targets = [{"__address__" = "provenance_gateway_dev:8000"}]
  metrics_path = "/metrics"
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.add_environment_development.receiver]
}

prometheus.relabel "add_environment_development" {
  rule {
    action       = "replace"
    target_label = "environment"
    replacement  = "development"
  }
  // Identifies which host produced the series. When more than one host runs
  // this stack, `environment` alone is ambiguous and their metrics interleave
  // under identical labels. Empty when HOST_LABEL is unset: Prometheus drops
  // empty labels, so an unconfigured host keeps its existing series identity.
  rule {
    action       = "replace"
    target_label = "host"
    replacement  = sys.env("HOST_LABEL")
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Scrape main gateway (main branch) ───────────────────────────────────────

prometheus.scrape "main" {
  targets = [{"__address__" = "provenance_gateway:8000"}]
  metrics_path = "/metrics"
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.add_environment_main.receiver]
}

prometheus.relabel "add_environment_main" {
  rule {
    action       = "replace"
    target_label = "environment"
    replacement  = "main"
  }
  rule {
    action       = "replace"
    target_label = "host"
    replacement  = sys.env("HOST_LABEL")
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Scrape the bundled Bee nodes' chain-backend metrics ─────────────────────
//
// Nothing watched the Gnosis RPC connection until this was added. When an
// endpoint started refusing calls, the first sign was a user getting
// "Failed to fetch wallet information from Swarm API" — the chain-reading
// endpoints (/wallet, /chequebook/balance, /chainstate) fail while everything
// else looks fine, so overall health stays green and nobody looks. Finding
// swarm_connect#296 meant reading Bee's logs by hand, per container.
//
// Only the bee_eth_backend_* series are kept. Bee exposes 874 series per node
// and almost none of them are about the chain backend; forwarding all of them
// would multiply Grafana Cloud ingest for no benefit.
//
// `up` is kept too, so a node that stops being scraped at all is
// distinguishable from one reporting zero errors — those look identical on a
// rate() graph otherwise. It is RENAMED to bee_up before being forwarded.
// Leaving it as `up` would have put Bee under labels that already mean
// "gateway": the Gateway Down alert matches up{job=~"prometheus.scrape.*"},
// which these components satisfy, so a stopped Bee node would have paged as a
// downed gateway. The Gateway Status panel would likewise have shown four
// series instead of two.
//
// Both nodes sit behind the `bee` compose profile. A host that does not run
// them will log scrape failures against these targets and report up == 0,
// which is the correct signal rather than silence.

prometheus.scrape "bee_main" {
  targets = [{"__address__" = "bee:1633"}]
  metrics_path = "/metrics"
  scrape_interval = "30s"
  forward_to = [prometheus.relabel.bee_main.receiver]
}

prometheus.relabel "bee_main" {
  rule {
    action        = "keep"
    source_labels = ["__name__"]
    regex         = "bee_eth_backend_.*|up"
  }
  rule {
    action        = "replace"
    source_labels = ["__name__"]
    regex         = "up"
    target_label  = "__name__"
    replacement   = "bee_up"
  }
  rule {
    action       = "replace"
    target_label = "environment"
    replacement  = "main"
  }
  rule {
    action       = "replace"
    target_label = "host"
    replacement  = sys.env("HOST_LABEL")
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "bee_development" {
  targets = [{"__address__" = "bee-dev:1633"}]
  metrics_path = "/metrics"
  scrape_interval = "30s"
  forward_to = [prometheus.relabel.bee_development.receiver]
}

prometheus.relabel "bee_development" {
  rule {
    action        = "keep"
    source_labels = ["__name__"]
    regex         = "bee_eth_backend_.*|up"
  }
  rule {
    action        = "replace"
    source_labels = ["__name__"]
    regex         = "up"
    target_label  = "__name__"
    replacement   = "bee_up"
  }
  rule {
    action       = "replace"
    target_label = "environment"
    replacement  = "development"
  }
  rule {
    action       = "replace"
    target_label = "host"
    replacement  = sys.env("HOST_LABEL")
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Probe each environment's public /health (#586) ──────────────────────────
//
// Everything above reads the gateway from inside: `up` says Alloy could scrape
// /metrics, and /metrics answers from the event loop without calling Bee. On
// 2026-11-03 staging kept answering /metrics for over 30 minutes while every
// Bee call failed, /health took more than 10 s and the proxy answered 502.
// Nothing alerted. This probe asks what a user asks: does the public URL
// answer, quickly, with a healthy Bee node.
//
// What the module checks, every 60 s per environment:
//   - an answer within 8 s (shorter than Docker's 10 s healthcheck timeout),
//   - status 200 (/health never answers 503 by design, so anything else is the
//     proxy or something in front of it),
//   - bee_node.healthy == true in the JSON body. A regex, because blackbox has
//     no portable JSON check: it requires "healthy":true inside the bee_node
//     object before any nested object, which is how read_root renders it
//     (tests/test_bee_failure_alerts.py checks the regex against the real
//     handler output). A failed regex shows as probe_failed_due_to_regex=1
//     with status 200, which the "Bee node not healthy" alert reads.
//
// It also covers Docker's `unhealthy` state. The container healthcheck is
// `curl -f http://localhost:8000/` with a 10 s timeout, and `/` and `/health`
// are the same handler. Docker marks the container unhealthy after 3 checks in
// a row fail or take over 10 s; each of those also fails this probe, which has
// the stricter timeout. Nothing restarts the container on it, deliberately: a
// restart can lose state that is not saved yet (see "State file save failures").
//
// Not a view from outside the host. Alloy probes the public hostnames from
// the host that serves them, through DNS, TLS and the reverse proxy, so it
// sees the proxy and the handler but not the host or its network going away
// ("Gateway Down" and "No Data" cover that partly). monitoring/alerting/README.md
// describes Grafana Synthetic Monitoring as the option for a truly external
// check.
//
// LABELS. job is set to "swarm_connect/health_probe". The Grafana stack already
// holds probe_success series from Synthetic Monitoring for other sites, so the
// alerts select on this job. Only four probe_* series are kept; `up` for this
// scrape is dropped, so it can never count as a gateway in "Gateway Down" or
// keep the "No Data" watchdog quiet.
//
// LOAD. Each /health call makes upstream calls to Bee and the Base RPC (#588),
// so this adds one call per environment per minute next to Docker's two.

prometheus.exporter.blackbox "public_health" {
  config = `{ modules: { http_health: { prober: http, timeout: 8s, http: { method: GET, valid_status_codes: [200], preferred_ip_protocol: ip4, fail_if_body_not_matches_regexp: ['"bee_node":\{[^{}]*"healthy":\s*true\s*[,}]'] } } } }`

  // The target name becomes the environment label below.
  target {
    name    = "main"
    address = "https://provenance-gateway.datafund.io/health"
    module  = "http_health"
  }

  target {
    name    = "development"
    address = "https://provenance-gateway.dev.datafund.io/health"
    module  = "http_health"
  }
}

discovery.relabel "public_health" {
  targets = prometheus.exporter.blackbox.public_health.targets

  // The exporter names each target's job "integrations/blackbox/<name>".
  rule {
    action        = "replace"
    source_labels = ["job"]
    regex         = "integrations/blackbox/(.*)"
    target_label  = "environment"
  }
  rule {
    action       = "replace"
    target_label = "job"
    replacement  = "swarm_connect/health_probe"
  }
  // The probed URL, rather than the component name the exporter puts here.
  rule {
    action        = "replace"
    source_labels = ["__param_target"]
    target_label  = "instance"
  }
  // The host that ran the probe, as on every other series.
  rule {
    action       = "replace"
    target_label = "host"
    replacement  = sys.env("HOST_LABEL")
  }
}

prometheus.scrape "public_health" {
  targets         = discovery.relabel.public_health.output
  scrape_interval = "60s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.public_health.receiver]
}

prometheus.relabel "public_health" {
  rule {
    action        = "keep"
    source_labels = ["__name__"]
    regex         = "probe_success|probe_http_status_code|probe_duration_seconds|probe_failed_due_to_regex"
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Ship gateway container logs to Loki ─────────────────────────────────────
//
// Metrics say how many errors there were; they never say what the error was.
// Reading an actual message meant SSH to the host and `docker logs` per
// container, which is how every investigation in this repository has started —
// including the one that found #299, where the answer was a single line in the
// reverse proxy's log.
//
// VOLUME, measured on the host before enabling this: production emits ~3,450
// lines/hour (~211 MB/month), staging ~60 lines/hour (~3 MB/month). Both well
// inside Grafana Cloud's included allowance, so everything is shipped rather
// than pre-filtered. Filtering at the source is the thing you regret during an
// incident, because the line you need is always the one that looked like noise.
//
// LABELS are deliberately few: container, environment, host and level. Loki
// indexes by label, and a high-cardinality label (a request id, an IP, a stamp
// id) multiplies the index and the bill. Everything else is searched with a
// filter expression at query time, which is what Loki is built for.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "gateway_containers" {
  targets = discovery.docker.containers.targets

  // Only the two gateways. Bee logs are high-volume and chain-focused; Alloy's
  // own logs would be self-referential. Matched on the compose SERVICE label
  // rather than the container name, which carries the project prefix and would
  // break if the project were ever renamed.
  rule {
    action        = "keep"
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "provenance_gateway(_dev)?"
  }

  rule {
    action        = "replace"
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "container"
  }

  // Relabel regexes are fully anchored, so "provenance_gateway" does not match
  // "provenance_gateway_dev" and the two rules cannot both fire.
  rule {
    action        = "replace"
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "provenance_gateway"
    target_label  = "environment"
    replacement   = "main"
  }
  rule {
    action        = "replace"
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "provenance_gateway_dev"
    target_label  = "environment"
    replacement   = "development"
  }

  // Same host label as the metrics pipeline, so a log line and a metric spike
  // can be attributed to the same machine when more than one runs this stack.
  rule {
    action       = "replace"
    target_label = "host"
    replacement  = sys.env("HOST_LABEL")
  }
}

loki.source.docker "gateway" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.gateway_containers.output
  labels     = {"job" = "swarm_connect/gateway"}
  forward_to = [loki.process.gateway.receiver]
}

loki.process "gateway" {
  // Promote the Python log level to a label so `{level="ERROR"}` works without
  // a substring match over the whole stream. Five possible values, so the
  // cardinality cost is negligible.
  //
  // Both line shapes the gateway produces start with the level:
  //   INFO:app.services.swarm_api:Successfully retrieved wallet info: ...
  //   INFO:     10.0.0.1:52344 - "GET /health HTTP/1.1" 200 OK
  // A line that matches neither — a traceback continuation, say — simply gets
  // no level label rather than being dropped.
  stage.regex {
    expression = "^(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL)"
  }
  stage.labels {
    values = {level = ""}
  }
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}

// ── Push to Grafana Cloud ───────────────────────────────────────────────────

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push"

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}
