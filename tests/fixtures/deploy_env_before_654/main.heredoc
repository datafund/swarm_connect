X402_FACILITATOR_BEARER_TOKEN=${{ secrets.X402_FACILITATOR_BEARER_TOKEN || '' }}
# Defaults to 1 (x402 v1 only) in both environments, unlike the network and
# facilitator above: 1 is the behaviour before x402 v2 existed. 1,2 turns on
# dual mode; the deploy check below then requires the facilitator to list v2.
X402_PROTOCOL_VERSIONS=${{ vars.X402_PROTOCOL_VERSIONS || '1' }}
X402_BZZ_USD_RATE=${{ vars.X402_BZZ_USD_RATE || '0.50' }}
