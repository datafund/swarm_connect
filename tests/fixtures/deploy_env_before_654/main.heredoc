X402_ENABLED=${{ vars.X402_ENABLED || 'false' }}
X402_PAY_TO_ADDRESS=${{ vars.X402_PAY_TO_ADDRESS || '' }}
# No defaults for production (#370): a missing variable must stop the
# gateway at startup (validate_x402_config), not silently pick a network.
X402_NETWORK=${{ vars.X402_NETWORK }}
X402_FACILITATOR_URL=${{ vars.X402_FACILITATOR_URL }}
